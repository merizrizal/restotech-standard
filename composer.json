{
    "name": "restotech/standard",
    "description": "Restotech Standard Laravel package",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.30"
    },
    "autoload": {
        "psr-4": {
            "Restotech\\Standard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Factories\\": "database/factories/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Restotech\\Standard\\StandardServiceProvider"
            ]
        }
    }
}
